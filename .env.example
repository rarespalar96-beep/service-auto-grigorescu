# Copiază în `.env.local` (local) sau setează în Cloudflare Pages → Settings →
# Environment variables (Production). Niciuna nu e obligatorie: cu toate goale,
# site-ul nu încarcă niciun script Google și nu afișează bannerul de cookie.
# Variabilele NEXT_PUBLIC_* sunt inlined la build → după modificare e nevoie de redeploy.

# --- Google (Consent Mode v2 + banner cookie) ---
# Dacă cel puțin unul dintre ID-uri e setat: se încarcă un singur gtag.js,
# consimțământul implicit e „denied" și apare bannerul Accept/Refuz.

# GA4 — ID-ul fluxului web, format G-XXXXXXX (Admin → Data streams).
NEXT_PUBLIC_GA_ID=
# Google Ads — ID-ul contului pentru conversii, format AW-XXXXXXX.
NEXT_PUBLIC_GADS_ID=

# Label-urile acțiunilor de conversie Google Ads (partea de după „/" din
# send_to: 'AW-XXXXXXX/LABEL'). Opționale: fără ele nu se trimite nicio conversie.
NEXT_PUBLIC_GADS_LABEL_TELEFON=
NEXT_PUBLIC_GADS_LABEL_PROGRAMARE=

# --- Plausible (opțional, cookieless, nu cere consimțământ) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Recenzii varianta B (v2, opțional) ---
# Necesită billing activat în Google Cloud.
GOOGLE_PLACES_API_KEY=
